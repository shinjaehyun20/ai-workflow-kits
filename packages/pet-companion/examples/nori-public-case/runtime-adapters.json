  },
  "runtime_support": {
    "codex": {
      "status": "active",
      "mode": "native",
      "notes": "Best baseline for bundle design and manual activation."
    },
    "claude_code": {
      "status": "draft",
      "mode": "external_companion",
      "notes": "Use a small state file and an external viewer."
    },
    "copilot": {
      "status": "draft",
      "mode": "external_companion",
      "notes": "Use a webview or overlay that reads the same contract."
    },
    "openclaw": {
      "status": "experimental",
      "mode": "avatar_plus_companion",
      "notes": "Map avatar first, then add state-driven rendering if needed."
    },
    "paperclip": {
      "status": "experimental",
      "mode": "widget_overlay",
      "notes": "Do not assume a native pet slot."
    }
  },
  "install_surface": {
    "codex": "Custom pet install and select flow.",
    "claude_code": "External viewer plus a runtime-owned state file.",
    "copilot": "Repository webview or external overlay.",
    "openclaw": "Avatar mapping plus optional state bridge.",
    "paperclip": "Dashboard or overlay widget only."
  },
  "display_mode": "external_companion"
}
