{
  "version": 1,
  "pet": {
    "id": "nori",
    "display_name": "Nori",
    "description": "Anthropomorphic fairy companion inspired by a fox and a magpie. Quiet, precise, and practical."
  },
  "assets": {
    "spritesheet": "assets/spritesheet.svg",
    "avatar": "assets/avatar.svg"
  },
  "atlas": {
    "cell_width": 192,
    "cell_height": 208,
    "rows": {
      "idle": {
        "row": 0,
        "frames": [0, 1, 2, 3],
        "frame_count": 4
      },
      "running": {
        "row": 1,
        "frames": [0, 1, 2, 3],
        "frame_count": 4
      },
      "review": {
        "row": 2,
        "frames": [0, 1, 2, 3],
        "frame_count": 4
      },
      "failed": {
        "row": 3,
        "frames": [0, 1, 2, 3],
        "frame_count": 4
      },
      "waving": {
        "row": 4,
        "frames": [0, 1, 2, 3],
        "frame_count": 4
      }
    }
  },
  "state_contract": {
    "runtime_states": ["idle", "running", "review", "failed", "waving"],
    "fallback_order": {
      "idle": ["idle"],
      "running": ["running", "idle"],
      "review": ["review", "idle"],
      "failed": ["failed", "idle"],
      "waving": ["waving", "idle"]
