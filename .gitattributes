# Keep public text artifacts stable across Windows/macOS/Linux.
* text=auto

*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.docx binary
*.hwp binary
*.hwpx binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.mp4 binary
*.mov binary
*.webm binary
